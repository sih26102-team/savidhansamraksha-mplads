# ==============================================================================
# Production Dockerfile for Backend Data API Server
# ==============================================================================
FROM node:22-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY lib/ ./lib/
COPY backend-data/ ./backend-data/
COPY ml-engine/ ./ml-engine/
COPY backend-case/ ./backend-case/

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @workspace/backend-data run build

# ==============================================================================
# Runtime Stage
# ==============================================================================
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5000

COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/backend-data/dist ./backend-data/dist
COPY --from=builder /app/backend-data/package.json ./backend-data/package.json

EXPOSE 5000

CMD ["node", "--enable-source-maps", "./backend-data/dist/index.mjs"]
