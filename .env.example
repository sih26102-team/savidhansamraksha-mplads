# ==============================================================================
# CivicShield / SavidhanSamraksha Master Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development

# API Server Port
PORT=5000

# PostgreSQL Connection String (Port 5433 for local isolated dev daemon)
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/savidhan

# Cookie Session Encryption Secret (Min 32 characters in production)
SESSION_SECRET=savidhan-samraksha-development-secret-key-32chars

# Frontend Configuration
VITE_API_URL=http://127.0.0.1:5000
BASE_PATH=/

# ==============================================================================
# Phase 3: Google Earth Engine (GEE) Satellite Change Detection
# ==============================================================================
# Set to 'true' for fast mock mode (< 50ms latency for smooth UI demos and hackathons)
# Set to 'false' to force live queries against ESA Copernicus Sentinel-2 Level-2A
GEE_MOCK_MODE=true

# Cloud-Native Credentials (Optional for live satellite queries):
# 1. Direct JSON string (Render / Cloud environment variable):
# GEE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"sih26102-mplads",...}
# 2. Or Google Cloud Project ID:
# EE_PROJECT_ID=sih26102-mplads

